# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# DATA_ENCRYPTION_KEY: Optional 64-char hex key (32 bytes) for AES-256-GCM encryption at rest.
# If omitted, a secure ephemeral key is generated in memory on startup.
DATA_ENCRYPTION_KEY=

# ADMIN_PASSCODE: Optional server-side admin passcode for unlocking the rule editor.
# If omitted, the app renders a first-run admin setup form to claim an admin password.
ADMIN_PASSCODE=
